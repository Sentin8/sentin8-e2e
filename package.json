{
  "name": "sentin8-platform-e2e-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Sentin8 platform e2e - Admin UI (Dash) + CLI full-scenario coverage.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --use-openssl-ca node_modules/@playwright/test/cli.js test --max-failures=1",
    "test:cli": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/",
    "test:ui": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/ui/ --headed --max-failures=1",
    "test:auth": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/auth.spec.ts",
    "test:sys": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/sys.spec.ts",
    "test:app": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/app.spec.ts",
    "test:storage": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/storage.spec.ts",
    "test:func": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/func.spec.ts",
    "test:cron": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/cron.spec.ts",
    "test:flow": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/flow.spec.ts",
    "test:bus": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/bus.spec.ts",
    "test:post": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/post.spec.ts",
    "test:stat": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/stat.spec.ts",
    "test:acme": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/acme.spec.ts",
    "test:db": "node --use-openssl-ca node_modules/@playwright/test/cli.js test tests/cli/db.spec.ts",
    "install-browsers": "playwright install chromium",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pnpm": "^12.3.4"
  }
}
